{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cttir.github.io/qupflowR/schema/protocol/v1/error-codes.schema.json",
  "title": "Error code registry",
  "description": "Structure of error-codes.json, the registry read by R and Java. Unique codes and message_key = error.<lower-case code> are checked by the tests.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["code", "http_status", "r_class", "retryable", "message_key", "source"],
    "additionalProperties": false,
    "properties": {
      "code": {
        "$ref": "common.schema.json#/definitions/error_code"
      },
      "http_status": {
        "type": ["integer", "null"],
        "minimum": 400,
        "maximum": 599
      },
      "r_class": {
        "enum": [
          "qp_connection_error",
          "qp_version_error",
          "qp_capability_error",
          "qp_validation_error",
          "qp_conflict_error",
          "qp_busy_error",
          "qp_recovery_error",
          "qp_job_error",
          "qp_bundle_error",
          "qp_runtime_error",
          "qp_reproduction_error",
          "qp_serialization_error",
          "qp_storage_error"
        ]
      },
      "retryable": {
        "type": "boolean"
      },
      "message_key": {
        "$ref": "common.schema.json#/definitions/message_key"
      },
      "source": {
        "enum": ["docs/06", "SP01b", "docs/15", "docs/18", "D022"]
      }
    }
  }
}
