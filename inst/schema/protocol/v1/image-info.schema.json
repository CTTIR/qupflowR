{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cttir.github.io/qupflowR/schema/protocol/v1/image-info.schema.json",
  "title": "Image information",
  "description": "Dimensions, channels and calibration of one image (GET /v1/sessions/{sid}/images/{iid}).",
  "type": "object",
  "required": [
    "image_id",
    "width",
    "height",
    "size_c",
    "size_z",
    "size_t",
    "pixel_type",
    "is_rgb",
    "channels",
    "downsamples",
    "calibration"
  ],
  "properties": {
    "image_id": {
      "$ref": "common.schema.json#/definitions/image_id"
    },
    "width": {
      "$ref": "common.schema.json#/definitions/positive_integer"
    },
    "height": {
      "$ref": "common.schema.json#/definitions/positive_integer"
    },
    "size_c": {
      "$ref": "common.schema.json#/definitions/positive_integer"
    },
    "size_z": {
      "$ref": "common.schema.json#/definitions/positive_integer"
    },
    "size_t": {
      "$ref": "common.schema.json#/definitions/positive_integer"
    },
    "pixel_type": {
      "enum": ["uint8", "int8", "uint16", "int16", "uint32", "int32", "float32", "float64"]
    },
    "is_rgb": {
      "type": "boolean"
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/channel"
      }
    },
    "downsamples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "minimum": 1
      }
    },
    "calibration": {
      "$ref": "#/definitions/calibration"
    }
  },
  "definitions": {
    "channel": {
      "type": "object",
      "required": ["index", "name", "color"],
      "properties": {
        "index": {
          "$ref": "common.schema.json#/definitions/count"
        },
        "name": {
          "type": "string",
          "maxLength": 1024
        },
        "color": {
          "type": ["string", "null"],
          "pattern": "^#[0-9a-f]{6}$"
        }
      }
    },
    "calibration": {
      "description": "Unknown calibration stays unknown: source is unknown unless metadata or the user proves it.",
      "type": "object",
      "required": ["pixel_width", "pixel_height", "unit", "source"],
      "properties": {
        "pixel_width": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "pixel_height": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 32
        },
        "z_spacing": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "time_interval": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "time_unit": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 32
        },
        "source": {
          "enum": ["metadata", "user", "unknown"]
        }
      },
      "anyOf": [
        {
          "properties": {
            "pixel_width": {
              "type": "number"
            },
            "pixel_height": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "pixel_width": {
              "type": "null"
            },
            "pixel_height": {
              "type": "null"
            },
            "unit": {
              "type": "null"
            },
            "source": {
              "const": "unknown"
            }
          }
        }
      ]
    }
  }
}
