# Project-local developer toolchain. Source from the repository root:
#   . dev/toolchain.env
# Nothing here changes global installations or the user's QuPath profile.

QUPFLOWR_ROOT="$(pwd)"
export QUPFLOWR_ROOT

# Temurin JDK 25.0.4.1+1 (sha256 of the release tarball is recorded in the T00 preflight report)
export JAVA_HOME="$QUPFLOWR_ROOT/.tools/jdk-25"
export PATH="$JAVA_HOME/bin:$PATH"

# Gradle and native-library caches stay inside the project
export GRADLE_USER_HOME="$QUPFLOWR_ROOT/.tools/gradle-home"
export QUPFLOWR_JAVACPP_CACHE="$QUPFLOWR_ROOT/.tools/javacpp-cache"

# Reference QuPath installation (read-only; never modified)
export QUPFLOWR_QUPATH_HOME="/opt/QuPath-v0.7.0"
export QUPFLOWR_QUPATH_SRC="$QUPFLOWR_ROOT/.tools/src/qupath-0.7.0"

# Headless X server extracted from the Ubuntu xvfb package (no root install)
export QUPFLOWR_XVFB="$QUPFLOWR_ROOT/.tools/xvfb/usr/bin/Xvfb"
export QUPFLOWR_XVFB_LIBS="$QUPFLOWR_ROOT/.tools/xvfb/usr/lib/x86_64-linux-gnu"
